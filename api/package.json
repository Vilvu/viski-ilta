{
  "name": "whisky-app-api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "predev": "npm run build",
    "dev": "func start",
    "lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 21",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@azure/cosmos": "4.1.1",
    "@azure/functions": "^4.5.0",
    "bcryptjs": "^3.0.3",
    "cookie": "^1.1.1",
    "jose": "^5.10.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^3.2.4"
  }
}
