# Azure Cosmos DB
COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_KEY=your-cosmos-key
COSMOS_DATABASE=whiskyapp

# Azure Static Web Apps Auth (configured in portal, not env vars)
# Google OAuth Client ID and Secret are configured in Azure portal

# Local development
# VITE_API_BASE_URL — leave unset when running via SWA CLI (swa start).
# The SWA CLI at http://localhost:4280 injects the x-ms-client-principal auth
# header into /api/* requests before forwarding them to the Functions runtime.
# Setting an absolute URL here bypasses the SWA CLI and breaks authentication
# on any endpoint that calls requireAuth().
#
# Only set this when testing the API directly without SWA CLI:
# VITE_API_BASE_URL=http://localhost:7071/api
